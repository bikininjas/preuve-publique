{
  "name": "preuve-publique",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "ingest": "node ingestion/cli.mjs",
    "polls:sync": "node --experimental-strip-types ingestion/polls/cli.ts",
    "candidates:sync": "node ingestion/candidates/cli.mjs",
    "measures:import": "node ingestion/candidates/editorial.mjs",
    "test:candidates": "node --experimental-strip-types --test \"ingestion/candidates/tests/*.test.mjs\"",
    "test:polls": "node --experimental-strip-types --test \"ingestion/polls/tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "test:ingestion": "node --test \"ingestion/tests/*.test.mjs\"",
    "test:reader": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.7",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.7",
    "fflate": "^0.8.3",
    "pg": "^8.23.0",
    "typescript": "5.9.2"
  }
}
