# preuve-publique — variables d'environnement
# Copier en .env.local (ignoré par Git). Valeurs vides ici : ne jamais écrire un
# secret, une clé ou un mot de passe dans ce fichier.

# --- Site (lecture publique, RLS) -----------------------------------------
# Lues au moment de la requête (rendu serveur). Sans elles, le site sert le
# dossier de référence local et l'affiche comme tel.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Privilégié (migrations, seed, scripts) -------------------------------
# Chaîne Postgres Supavisor en mode transaction (port 6543). Jamais dans le
# conteneur web. DATABASE_POOLER_URL est accepté comme autre nom.
DB_PG_URL=

# Clé de service : dépôt des captures dans le bucket immutable-archives
# (scripts d'archivage uniquement, jamais dans le conteneur web).
SUPABASE_SERVICE_ROLE_KEY=

# Les noms NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY sont
# également lus (ce sont ceux injectés par Cloud Run depuis Secret Manager).
