# preuve-publique — variables d'environnement
# Copier en .env.local (ignoré par Git). Valeurs vides ici : ne jamais écrire un
# secret, une clé ou un mot de passe dans ce fichier.
#
# SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY : configuration d'exécution du site.
# DB_PG_URL : connexion Postgres pour les migrations et l'ingestion — jamais dans
# le conteneur web.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DB_PG_URL=
